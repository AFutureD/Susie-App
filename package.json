{
  "name": "susie-app",
  "version": "0.1.0",
  "description": "Susie for macOS — chat with agents on Telegram through ACP and Codex.",
  "type": "module",
  "main": "dist/main/index.mjs",
  "license": "MIT",
  "author": "Huanan",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsdown",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "smoke": "SUSIE_SMOKE=1 SUSIE_CONFIG_DIR=\"$(mktemp -d)/susie\" SUSIE_USER_DATA_DIR=\"$(mktemp -d)\" electron . --headless",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:codex": "SUSIE_CODEX_IT=1 vitest run tests/integration/codex.test.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "pack": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^26.1.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chokidar": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "jotai": "^2.19.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intl": "^10.1.18",
    "react-router": "^7.13.1",
    "smol-toml": "^1.7.0",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.22.13",
    "typescript": "^5.9.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.145.0",
    "chrono-node": "^2.10.1",
    "node-telegram-bot-api": "^1.2.0",
    "nunjucks": "^3.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
